<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MarvelMod</AssemblyName>
    <RootNamespace>MarvelMod</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameLibsPath Condition="'$(GameLibsPath)'==''">$(MSBuildThisFileDirectory)GameLibs</GameLibsPath>
  </PropertyGroup>

  <!-- Exclude stub sub-projects from main compile -->
  <ItemGroup>
    <Compile Remove="GameLibsStub/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.679" />
    <PackageReference Include="BepInEx.Core"          Version="6.0.0-be.679" />
    <PackageReference Include="Reactor"               Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json"        Version="13.0.3" />
  </ItemGroup>

  <!-- Game assemblies: single merged stub (real types from IL2CPP interop on first run) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>GameLibs2/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
