  "system.infinitemultiverse.core": "Multiverse Core",
  "system.infinitemultiverse.core.desc": "The shared energy engine every power draws from: movement, defence and control fundamentals that work in any world.",
  "system.infinitemultiverse.stands": "Stands",
  "system.infinitemultiverse.stands.desc": "Player-bound spirit manifestations with their own models, AI, progression and signature abilities.",
  "system.infinitemultiverse.cursed_techniques": "Cursed Techniques",
  "system.infinitemultiverse.cursed_techniques.desc": "Cursed energy, innate techniques, Black Flash timing and Domain Expansions with their own internal worlds.",
  "system.infinitemultiverse.superheroes": "Superheroes & Mutants",
  "system.infinitemultiverse.superheroes.desc": "Telekinesis, elemental control, flight and speed, plus modelled hero suits with upgrade slots.",
  "system.infinitemultiverse.mystic_arts": "Mystic Arts",
  "system.infinitemultiverse.mystic_arts.desc": "Sling Ring portals, eldritch whips, mystic shields, astral projection and the Mirror Dimension.",
  "system.infinitemultiverse.infinity_gauntlet": "Infinity Gauntlet",
  "system.infinitemultiverse.infinity_gauntlet.desc": "Six independently functional stones, multi-stone combinations and a configurable Snap.",
  "system.infinitemultiverse.space": "Space Exploration",
  "system.infinitemultiverse.space.desc": "Spacecraft, orbital stations, alien worlds, oxygen and gravity simulation, black holes and wormholes.",
  "system.infinitemultiverse.portals": "Portal Technology",
  "system.infinitemultiverse.portals.desc": "Linked portal guns, momentum-preserving traversal, dimensional rifts and portal puzzles.",
  "system.infinitemultiverse.time_travel": "Time Travel",
  "system.infinitemultiverse.time_travel.desc": "A drivable time machine, time circuits and snapshot-based timelines that never overwrite your world.",
  "system.infinitemultiverse.weapons": "Weapons Arsenal",
  "system.infinitemultiverse.weapons.desc": "Sci-fi, spatial, cosmic, vintage, ancient, prehistoric and experimental weapons with real projectiles.",
  "system.infinitemultiverse.construction": "Construction",
  "system.infinitemultiverse.construction.desc": "Place one block, preview a hologram, and assemble whole buildings in animated, lag-free stages.",
  "system.infinitemultiverse.arena": "Combat Arenas",
  "system.infinitemultiverse.arena.desc": "Place-and-enter tactical arenas with teams, rounds, objectives, AI combatants and a map editor.",
  "system.infinitemultiverse.dimensions": "Dimensions",
  "system.infinitemultiverse.dimensions.desc": "The Backrooms, Astral Plane, Void, Riftlands, Infinite City, Soundscape and more on one shared framework.",
  "system.infinitemultiverse.sandbox": "Living Sandbox",
  "system.infinitemultiverse.sandbox.desc": "A simulated city with civilian routines, a branching police story and an experimental alchemy lab.",
  "system.infinitemultiverse.musical": "Reality Symphony",
  "system.infinitemultiverse.musical.desc": "Magical instruments, MIDI keyboard input and music that bends geometry until reality tears open.",
  "activation_type.infinitemultiverse.instant": "Instant",
  "activation_type.infinitemultiverse.toggle": "Toggle",
  "ability.infinitemultiverse.phase_step": "Phase Step",
  "ability.infinitemultiverse.phase_step.desc": "Blink along your line of sight to the nearest safe position. Destinations are validated first: you never land inside blocks, in lava or beyond the world border, and the cast is free if no safe spot exists.",
  "ability.infinitemultiverse.kinetic_leap": "Kinetic Leap",
  "ability.infinitemultiverse.kinetic_leap.desc": "Launch yourself where you are looking with guaranteed lift. Your next landing within a few seconds deals no fall damage.",
  "ability.infinitemultiverse.shockwave": "Shockwave",
  "ability.infinitemultiverse.shockwave.desc": "Release a radial blast that damages and hurls back nearby hostiles, strongest at the centre. Respects PvP rules, teams and your pets, and never breaks blocks.",
  "ability.infinitemultiverse.aegis_field": "Aegis Field",
  "ability.infinitemultiverse.aegis_field.desc": "Toggle an energy shell that absorbs part of all incoming damage. It drains energy every second and for every point absorbed, and collapses when your energy runs out.",
  "ability.infinitemultiverse.temporal_drag": "Temporal Drag",
  "ability.infinitemultiverse.temporal_drag.desc": "Dilate local time: nearby hostiles are heavily slowed and fatigued, and incoming projectiles lose most of their speed.",
